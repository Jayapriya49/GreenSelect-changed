# ==========================================
# RENEWAI Configuration Environment Variables
# ==========================================

# Backend Database Connection
# SQLite local development: sqlite:///./renewai.db
# PostgreSQL / PostGIS: postgresql://user:password@localhost:5432/renewai
DATABASE_URL=sqlite:///./renewai.db

# API Settings
PROJECT_NAME=RENEWAI
API_V1_STR=/api

# External Climatology API
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point

# Frontend Environment
VITE_API_URL=http://localhost:8000/api
